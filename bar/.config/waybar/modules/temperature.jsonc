{
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",	  
    "interval": 2,
    "warning-threshold": 80,
    "critical-threshold": 90, 
    "format": "<span>{icon}</span> {temperatureC}C",
    "format-warning": "<span>{icon}</span> {temperatureC}C",
    "format-critical": "<span>{icon}</span> {temperatureC}C",
    "format-icons": "",
    "tooltip": false
  }
}

